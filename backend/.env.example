PORT=8080
DATABASE_URL=postgres://habit:habit@localhost:5432/habit?sslmode=disable
CORS_ORIGINS=*

# Web Push. Generate a key pair once with: go run ./cmd/vapid
# Leave the keys empty to keep push reminders disabled.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Public URL of the frontend opened by a notification click.
PUBLIC_APP_URL=http://localhost:3000
