# Subdomain that points to this server. Used by the optional Caddy TLS proxy.
# Copy to .env and start with: docker compose --profile tls up -d
API_DOMAIN=api.example.com

# Web Push (VAPID). Generate once with:
#   docker compose run --rm --no-deps --entrypoint habit-vapid backend
# or locally: cd backend && go run ./cmd/vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Public URL of the frontend opened by a notification click.
PUBLIC_APP_URL=https://xabit.nbfx.ru
